{
  "name": "hasieva-go-getter-mini-app-e2e",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test:catalog": "node backend/catalog.e2e.cjs",
    "test:startup": "node backend/startup.e2e.cjs",
    "test:e2e": "npm run test:catalog && npm run test:startup",
    "build": "node build-react.mjs",
    "test:react": "node --test frontend/react/*.test.mjs",
    "test:react-browser": "node backend/react.e2e.cjs",
    "test:all": "npm run build && npm run test:react && node --test backend/*.test.cjs && npm run test:e2e && npm run test:react-browser && npm run test:story-browser && npm run test:focus-browser && npm run test:design-browser",
    "test:story-browser": "node backend/story.e2e.cjs",
    "test:focus-browser": "node backend/focus.e2e.cjs",
    "test:design-browser": "node backend/design.e2e.cjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.0"
  },
  "dependencies": {
    "motion": "14.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
